<Rules>
  <Rule name="OcultarComponente">
    <Actions>
        <Action ComponentType="ProductList" ActionType="VISIBLE" value="true" />
        <Action ComponentType="ProductList" ActionType="ENABLE" value="true" />
    </Actions>
  </Rule>

  <Rule name="DeshabilitarComponente">
    <Actions>
        <Action ComponentType="CartSummary" ActionType="VISIBLE" value="true" />
        <Action ComponentType="CartSummary" ActionType="ENABLE" value="false" />
    </Actions>
  </Rule>

  <Rule name="ACTIONS">
    <Actions>
        <Action ComponentType="ProductList" ActionType="ACTION" value="savePage()" />
    </Actions>
  </Rule>

  <!-- VISIBLE es el alias que devuelve el SP que carga la entidad TEST -->
  <!-- Equals es igual a ... -->
  <!-- NotEquals es no igual a ... -->

  <Rule Name="CONDITIONS">
    <Conditions LogicalOperation="AND">
      <Condition FieldName="TEST.VISIBLE" Operation="Equals" Value="Y" />
    </Conditions>
    <Actions>	
      <Action ComponentType="ProductList" ActionType="ENABLE" value="false" />	
    </Actions>
  </Rule>
</Rules>
